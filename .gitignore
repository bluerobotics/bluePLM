# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/

# Environment files
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Emitted by the composite tsconfig.node.json project alongside its .tsbuildinfo.
# Nothing imports it, and a committed copy goes stale against vite.config.ts.
vite.config.d.ts
# Generated eDrawings build payloads. Keep these paths narrow: other project
# outputs are either source-controlled or need their own explicit policy.
native/build/
edrawings-preview-host/bin/
edrawings-preview-host/obj/
edrawings-preview-host/publish/
edrawings-preview-host-tests/bin/
edrawings-preview-host-tests/obj/
resources/bin/win32/edrawings_preview.node
resources/bin/win32/edrawings-preview-host/

# Vite cache
.vite/

# Agent working documents (rules in .cursor/rules/ stay tracked)
.cursor/plans/
.cursor/reports/
REPORT.md
*_AGENT_REPORT.md
image/REPORT/


# Supabase CLI local state
supabase/.temp/

# Harness scratch. A leading underscore marks a one-shot probe written to answer
# a single question during an investigation; durable tooling carries no prefix.
# The convention predates this rule and was being kept by hand.
harness/**/_*
